<Project Sdk="Microsoft.NET.Sdk">

  <!-- Glassify for Windows. Same glass page as the Mac app (..\Glassify\Web\index.html); only the plumbing around it is Windows code.
       Builds on Windows, and compiles (not runs) on a Mac or Linux thanks to EnableWindowsTargeting. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Glassify</AssemblyName>
    <RootNamespace>Glassify</RootNamespace>
    <ApplicationIcon>Glassify.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\Glassify\Web\index.html" LogicalName="index.html" />
    <EmbeddedResource Include="Glassify.ico" LogicalName="Glassify.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4370.26" />
    <PackageReference Include="NAudio.Wasapi" Version="3.3.0" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
  </ItemGroup>

</Project>
